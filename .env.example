# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit real keys.

# --- Sarvam AI (VERIFY url + model name in the official Sarvam docs) ---
SARVAM_API_KEY=
SARVAM_API_URL=
SARVAM_MODEL=
LLM_ENABLED=false
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700
LLM_TIMEOUT=60

# --- Retrieval tuning ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
COLLECTION_NAME=ip_documents
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
AGENT_ENABLED=true
MAX_ATTEMPTS=4
HYBRID_ENABLED=true
LEXICAL_ACCEPT=true
MAX_DISTANCE=0.75
STRONG_DISTANCE=0.28
